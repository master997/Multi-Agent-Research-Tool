{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": ["source_type", "query", "retrieved_at", "results"],
  "properties": {
    "source_type": { "enum": ["web_search", "document"] },
    "query": { "type": "string" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "content", "source_attribution"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "source_attribution": {
            "type": "object",
            "required": ["url", "retrieved_at"],
            "properties": {
              "url": { "type": "string" },
              "retrieved_at": { "type": "string", "format": "date-time" },
              "relevance_note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
